<!-- Main container for the Contact Me page with top spacing -->
<div class="container mt-3">

  <!-- Card that centres the content and limits its maximum width -->
  <div class="card mx-auto mb-3 bg-light" style="max-width: 800px;">

    <div class="card-body">

      <!-- Displays the page title passed in from the Express route -->
      <h1 class="card-title"><%= title %></h1>

      <!-- Introduction explaining how visitors can get in touch -->
      <p>
        If you would like to get in touch, you can contact me through email or connect with me on my professional profiles below.
      </p>

      <!-- Section displaying contact information -->
      <h3>Contact Information</h3>

      <p>
        <i class="fa-solid fa-envelope"></i>
        Email: evan.degroot@ontariotechu.net
      </p>

      <!-- Section containing the message form -->
      <h3 class="mt-4">Send Me a Message</h3>

      <form>

        <!-- Input field for the visitor's name -->
        <div class="mb-3">
          <label for="name" class="form-label">Name</label>
          <input type="text" class="form-control" id="name" placeholder="Enter your name">
        </div>

        <!-- Input field for the visitor's email address -->
        <div class="mb-3">
          <label for="email" class="form-label">Email address</label>
          <input type="email" class="form-control" id="email" placeholder="name@example.com">
        </div>

        <!-- Text area where the visitor can write a message -->
        <div class="mb-3">
          <label for="message" class="form-label">Message</label>
          <textarea class="form-control" id="message" rows="3" placeholder="Write your message"></textarea>
        </div>

        <!-- Button styled using Bootstrap -->
        <button type="button" class="btn btn-primary">Send Message</button>

      </form>

    </div>
  </div>
</div>
